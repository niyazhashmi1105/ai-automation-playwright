{
  "name": "acme-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end web + API automation framework (Playwright Test + TypeScript)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web-chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --project=web-chromium --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com",
    "typecheck": "tsc --noEmit",
    "agents:init": "playwright init-agents --loop=claude"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
