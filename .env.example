# Copy to .env and fill in. Never commit .env.
# Which config/env/.env.<name> file to load (qa | staging)
TEST_ENV=qa

# Overrides (optional — defaults come from config/env/.env.<TEST_ENV>)
# WEB_BASE_URL=https://www.saucedemo.com
# API_BASE_URL=https://jsonplaceholder.typicode.com

# Secrets
WEB_USERNAME=standard_user
WEB_PASSWORD=
API_TOKEN=

# Optional
LOG_LEVEL=info          # debug | info | warn | error | silent
EXTRA_BROWSERS=false    # true = also run firefox + mobile chrome projects
